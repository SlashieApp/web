NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=""
NEXT_PUBLIC_MAPBOX_STYLE_DARK=""
# NEXT_PUBLIC_GRAPHQL_URL="https://api.slashie.app"
NEXT_PUBLIC_GRAPHQL_URL=""
SCHEMA_ACCESS_TOKEN=""
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="your_posthog_project_token_here"
# First-party PostHog reverse proxy (browser api_host). Rewrites on e.slashie.app
# forward to EU PostHog (eu.i.posthog.com / eu-assets.i.posthog.com). Client also
# sets ui_host=https://eu.posthog.com so toolbar / recording links still work.
# Requires DNS CNAME e.slashie.app → Vercel + domain attached to this project.
NEXT_PUBLIC_POSTHOG_HOST="https://e.slashie.app"
STITCH_API_KEY =""
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY =""
# Show fixture/test marketplace rows on /search and /workers. Leave unset in
# production — FE-142 hides placeholder tasks and thin junk worker profiles.
# Local / Storybook only: NEXT_PUBLIC_ALLOW_FIXTURE_LISTINGS=true
# NEXT_PUBLIC_ALLOW_FIXTURE_LISTINGS=""

# Cloudflare Turnstile (auth CAPTCHA). Leave empty locally to skip the widget.
# Never put the Turnstile secret key in the web app — verify tokens on the API.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

